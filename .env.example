# ---------------------------------------------------------------
# Text-to-Speech application - environment configuration
# Copy this file to `.env` and fill in your values.
# NEVER commit the real .env file to Git (it is in .gitignore).
# ---------------------------------------------------------------

# --- Server ---
PORT=5000
NODE_ENV=development

# Origin of the React app allowed to call the API (CORS)
CLIENT_ORIGIN=http://localhost:5173

# --- TTS provider ------------------------------------------------
# One of: edge | google | azure | elevenlabs
#   edge       -> Microsoft Edge Read-Aloud API. FREE, no API key required (default).
#   google     -> Google Cloud Text-to-Speech   (needs TTS_API_KEY)
#   azure      -> Microsoft Azure Speech        (needs TTS_API_KEY + TTS_REGION)
#   elevenlabs -> ElevenLabs TTS                (needs TTS_API_KEY)
TTS_PROVIDER=edge

# API key / credentials for the selected provider (never exposed to the browser)
TTS_API_KEY=
TTS_REGION=
TTS_ENDPOINT=

# --- Limits & security ---
# Maximum number of characters accepted per request
MAX_TEXT_LENGTH=500
# Requests allowed per IP per 15 minutes on POST /api/tts
TTS_RATE_LIMIT=10
# How long a generated audio file is kept on disk (minutes)
AUDIO_TTL_MINUTES=15
